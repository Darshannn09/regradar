# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.
API_DATA_GOV_KEY=your_key_here
CENSUS_API_KEY=your_census_key
LEGISCAN_API_KEY=your_legiscan_key

# Account identifier looks like: orgname-accountname
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password_or_access_token
SNOWFLAKE_WAREHOUSE=REGRADAR_WH
